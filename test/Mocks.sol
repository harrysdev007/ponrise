pragma solidity ^0.8.24;
import "FundedLaunch.sol";
contract MockToken {mapping(address=>uint256)public balanceOf;constructor(address to,uint256 n){balanceOf[to]=n;}function transfer(address to,uint256 n)external returns(bool){require(balanceOf[msg.sender]>=n,"Balance");balanceOf[msg.sender]-=n;balanceOf[to]+=n;return true;}}
contract MockCurve{}
contract MockQuote {mapping(address=>uint256)public balanceOf;mapping(address=>mapping(address=>uint256))public allowance;uint8 public immutable decimals;constructor(uint8 d){decimals=d;}function mint(address to,uint256 n)external{balanceOf[to]+=n;}function transfer(address to,uint256 n)external returns(bool){require(balanceOf[msg.sender]>=n,"Balance");balanceOf[msg.sender]-=n;balanceOf[to]+=n;return true;}function approve(address to,uint256 n)external returns(bool){allowance[msg.sender][to]=n;return true;}function transferFrom(address from,address to,uint256 n)external returns(bool){require(balanceOf[from]>=n&&allowance[from][msg.sender]>=n,"Allowance");balanceOf[from]-=n;allowance[from][msg.sender]-=n;balanceOf[to]+=n;return true;}}
contract MockEscrow {mapping(address=>uint256)public balanceOf;function depositFor(address a)external payable{balanceOf[a]+=msg.value;}mapping(address=>mapping(address=>uint256))public balanceOfToken;function depositTokenFor(address asset,address recipient,uint256 n)external{require(IERC20(asset).transferFrom(msg.sender,address(this),n));balanceOfToken[recipient][asset]+=n;}function claimToken(address token)external{uint256 n=balanceOfToken[msg.sender][token];balanceOfToken[msg.sender][token]=0;require(n>0&&IERC20(token).transfer(msg.sender,n));}function claim()external{uint256 n=balanceOf[msg.sender];require(n>0,"No fees");balanceOf[msg.sender]=0;(bool ok,)=msg.sender.call{value:n}("");require(ok);}}
contract MockPons is IPons,IPonsRouter {
 uint256 public launchFee=0.001 ether;bool public allowed=true;bool public fail;uint256 public refund;bytes32 public pin=keccak256("terms");address public lastCaller;address public lastFeeRecipient;bool public lastBuyback;
 mapping(address=>bool)public approvedPairTokens;mapping(address=>uint256)public thresholds;function setQuote(address asset,uint256 threshold)external{approvedPairTokens[asset]=true;thresholds[asset]=threshold;}function pairTokenEconomics(address asset)external view returns(uint256,uint256,uint8){return(thresholds[asset]*4/10,thresholds[asset],IERC20(asset).decimals());}function setBuybackEnabled(address,bool)external{}
 function canLaunch(address)external view returns(bool){return allowed;}
 function setAllowed(bool v)external{allowed=v;}function setFail(bool v)external{fail=v;}function setRefund(uint256 v)external{refund=v;}function setPin(bytes32 v)external{pin=v;}
 function launchAndBuy(TokenParams calldata p,uint256,address quote,uint256 input,uint256 minimum,address recipient,address[] calldata)external payable returns(address token,address curve,uint256 tokensOut){require(!fail,"Pons rejected");require(allowed,"Gate closed");require(p.expectedEconomics==pin,"Economics changed");require(msg.value==(quote==address(0)?input+launchFee:launchFee),"Value");if(quote!=address(0))require(IERC20(quote).transferFrom(msg.sender,address(this),input-refund));require(refund<=input,"Refund");lastCaller=msg.sender;lastFeeRecipient=p.creatorFeeRecipient;lastBuyback=p.buybackEnabled;tokensOut=(input-refund)*1000*(quote==address(0)?1:10**(18-IERC20(quote).decimals()));require(tokensOut>=minimum,"Slippage");token=address(new MockToken(recipient,tokensOut));curve=address(new MockCurve());if(refund>0&&quote==address(0)){(bool ok,)=msg.sender.call{value:refund}("");require(ok);}}
}
